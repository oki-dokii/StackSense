{
  "name": "stacksense",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Deterministic, evidence-backed technology stack recommendation engine",
  "engines": {
    "node": "^22.17.0 || ^24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "generate:types": "node scripts/generate-types.mjs",
    "check:types": "node scripts/generate-types.mjs --check",
    "typecheck": "tsc --noEmit && tsc -p apps/web/tsconfig.json",
    "build": "npm run check:types && tsc && npm run build:web",
    "validate": "node dist/apps/cli/src/main.js",
    "dev:validate": "tsx apps/cli/src/main.ts",
    "test": "npm run build:web && vitest run",
    "test:watch": "vitest",
    "check": "npm run check:types && npm run typecheck && npm test",
    "validate:batch": "node dist/apps/cli/src/main.js --batch",
    "plan:core": "node dist/apps/cli/src/main.js --core-plan",
    "plan:core:batch": "node dist/apps/cli/src/main.js --core-plan --batch",
    "dev:plan:core": "tsx apps/cli/src/main.ts --core-plan",
    "recommend": "node dist/apps/cli/src/main.js --recommend",
    "recommend:batch": "node dist/apps/cli/src/main.js --recommend --batch",
    "dev:recommend": "tsx apps/cli/src/main.ts --recommend",
    "start": "node dist/apps/api/src/main.js",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "vite build --config apps/web/vite.config.ts"
  },
  "dependencies": {
    "ajv": "8.20.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "json-schema-to-typescript": "15.0.4",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.1.0"
  }
}
