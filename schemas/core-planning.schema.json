  "required": [
    "schema_version",
    "engine_version",
    "catalog_version",
    "rules_version",
    "scope",
    "status",
    "summary",
    "core_stack",
    "architecture_style",
    "primary_region",
    "database_deployment",
    "database_region",
    "score",
    "score_breakdown",
    "feasible_core_plans",
    "features",
    "pending_requirements",
    "warnings",
    "assumptions",
    "validation_errors",
    "trace"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stacksense:core-planning:0.2",
  "title": "Phase 2 provisional core planning report",
  "description": "Development-stage report, not the organiser recommendation output. Missing compliance evidence blocks publication of core_stack; no costs or supporting-service approval is implied.",
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "core_plan"
          }
        }
      },
      "then": {
        "properties": {
          "core_stack": {
            "type": "object"
          },
          "architecture_style": {
            "type": "string"
          },
          "score": {
            "type": "integer"
          },
          "score_breakdown": {
            "minItems": 6,
            "maxItems": 6
          },
          "feasible_core_plans": {
            "minimum": 1
          },
          "validation_errors": {
            "maxItems": 0
          },
          "warnings": {
            "items": {
              "properties": {
                "severity": {
                  "enum": [
                    "info",
                    "warning"
                  ]
                }
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "blocked",
              "invalid_input"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "core_stack": {
            "type": "null"
          },
          "architecture_style": {
            "type": "null"
          },
          "score": {
            "type": "null"
          },
          "score_breakdown": {
            "maxItems": 0
          },
          "primary_region": {
            "type": "null"
          },
          "database_region": {
            "type": "null"
          },
          "database_deployment": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_input"
          }
        }
      },
      "then": {
        "properties": {
          "validation_errors": {
            "minItems": 1
          },
          "feasible_core_plans": {
            "const": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "blocked"
          }
        }
      },
      "then": {
        "properties": {
          "validation_errors": {
            "maxItems": 0
          },
          "warnings": {
            "contains": {
              "properties": {
                "severity": {
                  "const": "critical"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    }
  ]
}
