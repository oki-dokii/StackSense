{
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_on": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "checked_on": {
            "type": "string",
            "minLength": 1
          },
          "scope": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "title",
          "url",
          "checked_on",
          "scope"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "services": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": [
              "cache",
              "queue",
              "search",
              "auth",
              "storage",
              "cdn",
              "realtime",
              "payments",
              "ml",
              "ci_cd",
              "observability",
              "other"
            ]
          },
          "choice": {
            "type": "string",
            "minLength": 1
          },
          "capability": {
            "type": "string",
            "minLength": 1
          },
          "placement": {
            "enum": [
              "host",
              "device",
              "database",
              "external",
              "build"
            ]
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "compute_units": {
            "type": "number",
            "minimum": 0,
            "maximum": 10
          },
          "database_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "frontend_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "providers": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 0
          },
          "alternative": {
            "type": "string",
            "minLength": 1
          },
          "why_not": {
            "type": "string",
            "minLength": 1
          },
          "tradeoffs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "layer",
          "choice",
          "capability",
          "placement",
          "source_ids",
          "compute_units",
          "database_ids",
          "frontend_ids",
          "providers",
          "alternative",
          "why_not",
          "tradeoffs"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "frameworks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "technical_controls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "owner_actions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "verification": {
            "const": "design_only_not_certified"
          }
        },
        "required": [
          "id",
          "source_ids",
          "technical_controls",
          "owner_actions",
          "verification"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "pricing": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number",
            "minimum": 0
          },
          "max": {
            "type": "number",
            "minimum": 0
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "min",
          "max",
          "source_ids",
          "basis"
        ],
        "additionalProperties": false
      }
    },
    "lifecycle": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "product": {
            "type": "string",
            "minLength": 1
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "ended": {
            "type": "string",
            "minLength": 1
          },
          "source_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "required": [
          "id",
          "product",
          "pattern",
          "ended",
          "source_ids"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "reviewed_on",
    "sources",
    "services",
    "frameworks",
    "pricing",
    "lifecycle"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stacksense:services:0.5",
  "title": "Supporting services, control design and planning price references"
}
