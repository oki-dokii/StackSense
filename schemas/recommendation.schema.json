{
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string"
    },
    "engine_version": {
      "type": "string"
    },
    "catalog_version": {
      "type": "string"
    },
    "rules_version": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "ok",
        "ok_with_warnings",
        "infeasible",
        "invalid_input"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "architecture_style": {
      "type": "string",
      "enum": [
        "static",
        "monolith",
        "modular_monolith",
        "serverless",
        "service_oriented",
        "microservices",
        "hybrid",
        "other"
      ]
    },
    "stack": {
      "anyOf": [
        {
          "$ref": "#/definitions/stack"
        },
        {
          "type": "null"
        }
      ]
    },
    "estimated_monthly_cost_usd": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "min",
        "max",
        "assumptions"
      ]
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/warning"
      }
    },
    "assumptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "validation_errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true,
        "required": [
          "field",
          "message"
        ]
      }
    },
    "review_actions": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/reviewAction"
      }
    },
    "integration_reviews": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/integrationReview"
      }
    },
    "cost_groups": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/costGroup"
      }
    },
    "cost_sensitivity": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/costSensitivity"
      }
    },
    "plan_comparison": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/planComparison"
      }
    },
    "estimated_cost_scope": {
      "type": "string",
      "enum": [
        "infrastructure_and_operations"
      ]
    },
    "estimated_total_monthly_cost_usd": {
      "type": "object",
      "properties": {
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "assumptions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "min",
        "max",
        "assumptions"
      ]
    },
    "budget_planning": {
      "type": "object",
      "properties": {
        "scope": {
          "const": "optional_proposals_original_result_unchanged"
        },
        "cheapest_same_scope": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "plan_id": {
                  "type": "string"
                },
                "core": {
                  "type": "object",
                  "properties": {
                    "frontend": {
                      "type": "string"
                    },
                    "backend": {
                      "type": "string"
                    },
                    "database": {
                      "type": "string"
                    },
                    "hosting": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "frontend",
                    "backend",
                    "database",
                    "hosting"
                  ],
                  "additionalProperties": false
                },
                "monthly_infrastructure_usd": {
                  "type": "object",
                  "properties": {
                    "min": {
                      "type": "number",
                      "minimum": 0
                    },
                    "max": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "min",
                    "max"
                  ],
                  "additionalProperties": false
                },
                "budget_fit": {
                  "enum": [
                    "within_upper",
                    "range_risk",
                    "over_budget"
                  ]
                }
              },
              "required": [
                "plan_id",
                "core",
                "monthly_infrastructure_usd",
                "budget_fit"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "requires_acceptance": {
                "const": true
              },
              "changes": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "properties": {
                    "field": {
                      "enum": [
                        "infrastructure.deployment_model",
                        "requirements.availability"
                      ]
                    },
                    "from": {
                      "type": "string"
                    },
                    "to": {
                      "type": "string"
                    },
                    "consequence": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "field",
                    "from",
                    "to",
                    "consequence"
                  ],
                  "additionalProperties": false
                }
              },
              "core": {
                "type": "object",
                "properties": {
                  "frontend": {
                    "type": "string"
                  },
                  "backend": {
                    "type": "string"
                  },
                  "database": {
                    "type": "string"
                  },
                  "hosting": {
                    "type": "string"
                  }
                },
                "required": [
                  "frontend",
                  "backend",
                  "database",
                  "hosting"
                ],
                "additionalProperties": false
              },
              "supporting_services": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "plan_id": {
                "type": "string"
              },
              "primary_region": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "monthly_infrastructure_usd": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "monthly_total_usd": {
                "type": "object",
                "properties": {
                  "min": {
                    "type": "number",
                    "minimum": 0
                  },
                  "max": {
                    "type": "number",
                    "minimum": 0
                  }
                },
                "required": [
                  "min",
                  "max"
                ],
                "additionalProperties": false
              },
              "budget_fit": {
                "enum": [
                  "within_upper",
                  "range_risk",
                  "over_budget"
                ]
              },
              "warnings": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/warning"
                }
              },
              "assumptions": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "required": [
              "id",
              "requires_acceptance",
              "changes",
              "core",
              "supporting_services",
              "plan_id",
              "primary_region",
              "monthly_infrastructure_usd",
              "monthly_total_usd",
              "budget_fit",
              "warnings",
              "assumptions"
            ],
            "additionalProperties": false
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "budget_usd": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "required": [
        "scope",
        "cheapest_same_scope",
        "options",
        "notes",
        "budget_usd"
      ],
      "additionalProperties": false
    }
  },
  "additionalProperties": true,
  "required": [
    "status",
    "summary",
    "architecture_style",
    "stack",
    "estimated_monthly_cost_usd",
    "warnings",
    "assumptions",
    "validation_errors"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:stacksense:recommendation:0.1",
  "title": "StackSense recommendation result \u2014 project profile",
  "description": "Requires nonempty alternatives, drivers and tradeoffs for all components; stricter than the minimum output table. Semantic rules (min<=max, critical warning, driver paths) are also required.",
  "definitions": {
    "component": {
      "type": "object",
      "properties": {
        "choice": {
          "type": "string",
          "minLength": 1
        },
        "justification": {
          "type": "string",
          "minLength": 1
        },
        "driven_by": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "alternatives": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "choice": {
                "type": "string",
                "minLength": 1
              },
              "why_not": {
                "type": "string",
                "minLength": 1
              }
            },
            "additionalProperties": true,
            "required": [
              "choice",
              "why_not"
            ]
          },
          "minItems": 1
        },
        "tradeoffs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "additionalProperties": true,
      "required": [
        "choice",
        "justification",
        "driven_by",
        "alternatives",
        "tradeoffs"
      ]
    },
    "stack": {
      "type": "object",
      "properties": {
        "frontend": {
          "$ref": "#/definitions/component"
        },
        "backend": {
          "$ref": "#/definitions/component"
        },
        "database": {
          "$ref": "#/definitions/component"
        },
        "hosting": {
          "$ref": "#/definitions/component"
        },
        "supporting": {
          "type": "array",
          "items": {
            "allOf": [
              {
                "$ref": "#/definitions/component"
              },
              {
                "type": "object",
                "properties": {
                  "layer": {
                    "type": "string",
                    "enum": [
                      "cache",
                      "queue",
                      "search",
                      "auth",
                      "storage",
                      "cdn",
                      "realtime",
                      "payments",
                      "ml",
                      "ci_cd",
                      "observability",
                      "other"
                    ]
                  }
                },
                "additionalProperties": true,
                "required": [
                  "layer"
                ]
              }
            ]
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "frontend",
        "backend",
        "database",
        "hosting"
      ]
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "info",
            "warning",
            "critical"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true,
      "required": [
        "code",
        "severity",
        "message",
        "fields"
      ]
    },
    "reviewAction": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "evidence_gap",
            "constraint_conflict",
            "model_limit"
          ]
        },
        "fields": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "affected_components": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "evidence_required": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "next_action": {
          "type": "string",
          "minLength": 1
        },
        "resolution_gate": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "checked_on": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "checked_on",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "id",
        "code",
        "kind",
        "fields",
        "affected_components",
        "evidence_required",
        "next_action",
        "resolution_gate",
        "references"
      ],
      "additionalProperties": false
    },
    "integrationReview": {
      "type": "object",
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "approach": {
          "enum": [
            "federation_review",
            "database_reuse_review",
            "inventory_review"
          ]
        },
        "approval": {
          "const": "pending_project_evidence"
        },
        "protocol": {
          "type": "string",
          "minLength": 1
        },
        "data_boundary": {
          "type": "string",
          "minLength": 1
        },
        "cost_treatment": {
          "type": "string",
          "minLength": 1
        },
        "tasks": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "title": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "minLength": 1
              },
              "checked_on": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "title",
              "url",
              "checked_on",
              "scope"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "system",
        "approach",
        "approval",
        "protocol",
        "data_boundary",
        "cost_treatment",
        "tasks",
        "references"
      ],
      "additionalProperties": false
    },
    "costGroup": {
      "type": "object",
      "properties": {
        "category": {
          "enum": [
            "infrastructure_and_operations",
            "payment_and_message_activity"
          ]
        },
        "min": {
          "type": "number",
          "minimum": 0
        },
        "max": {
          "type": "number",
          "minimum": 0
        },
        "line_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [
        "category",
        "min",
        "max",
        "line_ids"
      ],
      "additionalProperties": false
    },
    "costSensitivity": {
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "minLength": 1
        },
        "baseline_value": {
          "type": "number",
          "minimum": 0
        },
        "baseline_origin": {
          "enum": [
            "supplied",
            "assumed"
          ]
        },
        "scope": {
          "const": "selected_plan_fixed_no_reranking"
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number",
                "minimum": 0
              },
              "status": {
                "enum": [
                  "estimated",
                  "model_limit"
                ]
              },
              "min": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "max": {
                "type": [
                  "number",
                  "null"
                ]
              },
              "upper_delta_usd": {
                "type": [
                  "number",
                  "null"
                ]
              }
            },
            "required": [
              "value",
              "status",
              "min",
              "max",
              "upper_delta_usd"
            ],
            "additionalProperties": false
          }
        },
        "cost_category": {
          "type": "string",
          "enum": [
            "infrastructure_and_operations",
            "payment_and_message_activity"
          ]
        }
      },
      "required": [
        "field",
        "baseline_value",
        "baseline_origin",
        "scope",
        "samples",
        "cost_category"
      ],
      "additionalProperties": false
    },
    "planComparison": {
      "type": "object",
      "properties": {
        "plan_id": {
          "type": "string",
          "minLength": 1
        },
        "selected": {
          "type": "boolean"
        },
        "architecture_style": {
          "type": "string",
          "minLength": 1
        },
        "core": {
          "type": "object",
          "properties": {
            "frontend": {
              "type": "string",
              "minLength": 1
            },
            "backend": {
              "type": "string",
              "minLength": 1
            },
            "database": {
              "type": "string",
              "minLength": 1
            },
            "hosting": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "frontend",
            "backend",
            "database",
            "hosting"
          ],
          "additionalProperties": false
        },
        "supporting_services": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "primary_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "database_region": {
          "type": [
            "string",
            "null"
          ]
        },
        "score": {
          "type": "number",
          "minimum": 0
        },
        "score_delta": {
          "type": "number"
        },
        "tied_on_score": {
          "type": "boolean"
        },
        "monthly_usd": {
          "type": "object",
          "properties": {
            "min": {
              "type": "number",
              "minimum": 0
            },
            "max": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "min",
            "max"
          ],
          "additionalProperties": false
        },
        "operated_components": {
          "type": "number",
          "minimum": 0
        },
        "budget_fit": {
          "enum": [
            "within_upper",
            "range_risk",
            "over_budget"
          ]
        },
        "warning_codes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "cost_assumptions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "retained_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        }
      },
      "required": [
        "plan_id",
        "selected",
        "architecture_style",
        "core",
        "supporting_services",
        "primary_region",
        "database_region",
        "score",
        "score_delta",
        "tied_on_score",
        "monthly_usd",
        "operated_components",
        "budget_fit",
        "warning_codes",
        "cost_assumptions",
        "retained_constraints"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "invalid_input"
          }
        }
      },
      "then": {
        "properties": {
          "stack": {
            "type": "null"
          },
          "validation_errors": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "infeasible"
          }
        }
      },
      "then": {
        "properties": {
          "stack": {
            "type": "null"
          },
          "validation_errors": {
            "maxItems": 0
          },
          "warnings": {
            "contains": {
              "type": "object",
              "properties": {
                "severity": {
                  "const": "critical"
                }
              },
              "required": [
                "severity"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "ok",
              "ok_with_warnings"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "stack": {
            "$ref": "#/definitions/stack"
          },
          "validation_errors": {
            "maxItems": 0
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok_with_warnings"
          }
        }
      },
      "then": {
        "properties": {
          "warnings": {
            "minItems": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "ok"
          }
        }
      },
      "then": {
        "properties": {
          "warnings": {
            "items": {
              "allOf": [
                {
                  "$ref": "#/definitions/warning"
                },
                {
                  "properties": {
                    "severity": {
                      "const": "info"
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "engine_version": {
            "const": "0.9.0"
          }
        },
        "required": [
          "engine_version"
        ]
      },
      "then": {
        "required": [
          "review_actions",
          "integration_reviews",
          "cost_groups",
          "cost_sensitivity",
          "plan_comparison",
          "estimated_cost_scope"
        ]
      }
    }
  ]
}
